{
  "name": "parkkasa",
  "version": "1.1.0",
  "description": "ParkKasa — otopark kasa + abone + gün sonu (web paneli)",
  "productName": "ParkKasa",
  "author": "ParkKasa <destek@parkkasa.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,vue,css,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,vue,css,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run start:dev --prefix backend\" \"quasar dev\"",
    "dev:web": "quasar dev",
    "dev:api": "npm run start:dev --prefix backend",
    "dev:electron": "quasar dev -m electron",
    "build": "quasar build",
    "build:electron": "quasar build -m electron",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "@supabase/supabase-js": "^2.57.4",
    "axios": "^1.12.2",
    "pinia": "^3.0.3",
    "quasar": "^2.27.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.8.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.0"
  },
  "keywords": [
    "otopark",
    "parkkasa",
    "kasa",
    "abone",
    "quasar"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
