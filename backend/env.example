# Database — local Docker veya Supabase connection pooler
DATABASE_URL="postgresql://otopark:otopark@localhost:5432/otopark?schema=public"
# Supabase migrations için direct connection (db.xxx.supabase.co:5432)
DIRECT_URL="postgresql://otopark:otopark@localhost:5432/otopark?schema=public"

PORT=3000
CORS_ORIGIN="http://localhost:9000,http://localhost:9001"

# Supabase Auth (Project Settings → API). JWT doğrulama yalnızca JWKS (HS256 yok).
# JWT secret / service role / DATABASE_URL asla VITE_ önekiyle veya frontend .env içine konmaz.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="parking-images"

# Dakikada istek limiti (TTL milisaniye)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# productionda Swagger kapalıdır. Açmak için:
# SWAGGER_ENABLED=true

# Lisans (HMAC). openssl rand -hex 32
LICENSE_SECRET="replace-with-long-random"
LICENSE_ENFORCE=true
LICENSE_TRIAL_DAYS=0

# Demo seed (npm run prisma:seed)
DEMO_EMAIL="demo@parkkasa.com"
DEMO_PASSWORD="DemoPark1!"


